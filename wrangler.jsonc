{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naman-world",
  "account_id": "ccc40688201525bb82aed7aa2e045405",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "BLOG_BUCKET",
      "bucket_name": "naman-blog"
    }
  ],
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "naman-analytics",
      "database_id": "effec409-ba29-4939-bad5-8066bd031545",
      "migrations_dir": "migrations/analytics"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "BLOG_NAMESPACE": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  },
  "ratelimits": [
    {
      "name": "ANALYTICS_LIMIT",
      "namespace_id": "20260923",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "TOKENIZER_LIMIT",
      "namespace_id": "20260921",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 10000
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "naman.world",
      "custom_domain": true,
      "zone_id": "c6e76afa19b5c5993cf8e80cdd7b443e"
    },
    {
      "pattern": "www.naman.world",
      "custom_domain": true,
      "zone_id": "c6e76afa19b5c5993cf8e80cdd7b443e"
    }
  ]
}

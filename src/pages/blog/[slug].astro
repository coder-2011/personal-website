---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCatalogue from '../../components/BlogCatalogue.astro';
import { readingSummary } from '../../lib/blog/reading.mjs';
import { prepareCatalogue } from '../../lib/blog/catalogue.mjs';
import { blogStore } from '../../lib/blog/store.mjs';
import { blogPageHeaders } from '../../lib/blog/http.mjs';
import { presentPostForReading } from '../../lib/blog/code-upgrade.mjs';
import 'katex/dist/katex.min.css';
import '../../styles/blog.css';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
let post = null;
let unavailable = false;
try { post = await blogStore().post(Astro.params.slug); }
catch { unavailable = true; }
if (!post) Astro.response.status = unavailable ? 503 : 404;
else for (const [key,value] of Object.entries(blogPageHeaders)) Astro.response.headers.set(key,value);
const presentation = prepareCatalogue(post ? await presentPostForReading(post.html, post.markdown) : '');
---
<BaseLayout title={`${post?.title || 'Post unavailable'} | Naman Chetwani`} description={post?.description || 'Notes and essays by Naman Chetwani.'}>
  {post && <div class="blog-reading-progress" aria-hidden="true"></div>}
  <main class:list={["page", "blog-page", { "has-catalogue": presentation.outline.length > 0 }]}>
    <div class="page-top"><nav class="top-nav" aria-label="Primary">
      <a data-astro-prefetch="load" class="nav-link" href="/" data-echo="Naman Chetwani">Naman Chetwani</a>
      <a data-astro-prefetch="load" class="nav-link" href="/things-ive-done" data-echo="Things I've Done">Things I've Done</a>
      <a data-astro-prefetch="load" class="nav-link current" href="/blog" data-echo="Blog">Blog</a>
    </nav></div>
    <div class="blog-reading-tools" hidden><button type="button" aria-haspopup="dialog" aria-expanded="false">☰ Catalogue</button></div>
    <div class="blog-reading-layout">
    <BlogCatalogue entries={presentation.outline} />
    <article class="essay blog-post" data-slug={post?.slug} data-revision={post?.revision}>
      <h1 id="post-title">{post?.title || (unavailable ? 'Temporarily unavailable' : 'Post not found')}</h1>
      {post ? <><p class="wisdom-meta blog-post-meta" id="post-meta"><time id="post-date" datetime={post.date}>{post.date}</time><span id="post-reading" title="Reading time estimated at 200 words per minute">{readingSummary(presentation.html)}</span></p><div id="post-body" set:html={presentation.html} /></> : <p>{unavailable ? 'Please try again shortly.' : 'This post may have been unpublished.'} <a href="/blog">Back to the blog.</a></p>}
    </article>
    </div>
  </main>
</BaseLayout>
<script>
  import { enableCodeCopy } from '../../scripts/blog-code.mjs';
  import { enableCatalogue } from '../../scripts/blog-catalogue.mjs';
  import { enableSidenotes } from '../../scripts/blog-sidenotes.mjs';
  import { enableReadingProgress } from '../../scripts/blog-progress.mjs';
  const progress = document.querySelector<HTMLElement>('.blog-reading-progress');
  const cleanProgress = progress ? enableReadingProgress(progress) : () => {};
  const article = document.querySelector<HTMLElement>('.blog-post');
  if (article) enableCodeCopy(article);
  const body = document.getElementById('post-body');
  const page = document.querySelector<HTMLElement>('.blog-page')!;
  let cleanCatalogue = body ? enableCatalogue(page, body) : () => {};
  let cleanSidenotes = body ? enableSidenotes(body) : () => {};
  let revision = article?.dataset.revision;
  let stopped = false;
  let timer: ReturnType<typeof setTimeout>;
  async function update() {
    if (stopped || !article?.dataset.slug) return;
    let delay = 3000;
    try {
      if (!document.hidden) {
        const response = await fetch(`/api/blog/posts/${article.dataset.slug}?revision=${encodeURIComponent(revision || '')}`, { cache: 'no-store', signal: AbortSignal.timeout(8000) });
        if (response.status === 404) {
          document.getElementById('post-meta')!.hidden = true;
          cleanProgress();
          cleanSidenotes();
          cleanCatalogue();
          page.querySelector<HTMLElement>('.blog-catalogue')!.hidden = true;
          page.querySelector<HTMLElement>('.blog-reading-tools')!.hidden = true;
          page.classList.remove('has-catalogue');
          document.getElementById('post-title')!.textContent = 'Post no longer available';
          document.getElementById('post-body')!.textContent = 'This post has been unpublished.';
          stopped = true;
        } else if (response.ok && response.status !== 204) {
          const post = await response.json();
          if (post.revision !== revision) {
            document.getElementById('post-title')!.textContent = post.title;
            document.getElementById('post-date')!.textContent = post.date;
            document.getElementById('post-date')!.setAttribute('datetime', post.date);
            document.getElementById('post-reading')!.textContent = post.readingSummary;
            cleanSidenotes();
            cleanCatalogue();
            body!.innerHTML = post.html;
            cleanCatalogue = enableCatalogue(page, body!);
            cleanSidenotes = enableSidenotes(body!);
            article.querySelectorAll<HTMLButtonElement>('.blog-code-copy').forEach(button => { button.hidden = false; });
            document.title = `${post.title} | Naman Chetwani`;
            revision = post.revision;
          }
        } else if (response.status !== 204) delay = 15000;
      }
    } catch { delay = 15000; }
    if (!stopped) timer = setTimeout(update, delay);
  }
  timer = setTimeout(update, 3000);
  window.addEventListener('pagehide', () => { stopped = true; clearTimeout(timer); });
  window.addEventListener('pageshow', event => {
    if (event.persisted) { stopped = false; clearTimeout(timer); void update(); }
  });
</script>

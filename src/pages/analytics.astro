---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Visitor counting | Naman Chetwani" description="How visitor counting works on naman.world.">
  <main class="page"><article class="essay">
    <p><a href="/">← Home</a></p>
    <h1>Visitor counting</h1>
    <p>This site estimates how many browsers visit the website and each blog post. It stores a random ID in your browser, so reloading a page doesn't count you again.</p>
    <p>The server stores a keyed hash of that ID and the latest visit time for the site and each post. It does not store your IP address, referrer, or a log of individual pageviews. Counts cover all visits since counting was installed. Browser IDs and visitor records do not expire automatically, so returning browsers are counted once.</p>
    <p>Different browsers and cleared browser storage can count as separate visitors. Do Not Track and Global Privacy Control are respected.</p>
    <label><input id="count-visits" type="checkbox" /> Count visits from this browser</label>
    <p id="analytics-status" role="status"></p>
  </article></main>
</BaseLayout>
<script>
  const toggle = document.querySelector<HTMLInputElement>('#count-visits')!;
  const status = document.querySelector<HTMLElement>('#analytics-status')!;
  function update() {
    try {
      toggle.checked = localStorage.getItem('naman.analytics.disabled') !== '1';
      status.textContent = toggle.checked ? 'Visitor counting is enabled, subject to your browser privacy preferences.' : 'Visits from this browser are excluded.';
    } catch { toggle.disabled = true; status.textContent = 'Browser storage is blocked, so visits are not counted.'; }
  }
  toggle.addEventListener('change', () => {
    try {
      localStorage.setItem('naman.analytics.disabled', toggle.checked ? '0' : '1');
      if (!toggle.checked) localStorage.removeItem('naman.analytics.visitor');
    } catch {}
    update();
  });
  update();
</script>

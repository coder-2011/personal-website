---
const contactLinks = [
  { label: "+1 925 895 9674", href: "tel:+19258959674" },
  { label: "naman.chetwani@gmail.com", href: "mailto:naman.chetwani@gmail.com" },
  { label: "github.com/coder-2011", href: "https://github.com/coder-2011" },
  { label: "naman.world", href: "https://naman.world" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>Naman Chetwani Resume</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Restores the shared theme preference before the resume paints.
      (() => {
        try {
          if (window.localStorage.getItem("naman-theme") === "light") {
            document.documentElement.dataset.theme = "light";
            document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#ffffff");
          }
        } catch {
          // Theme preference is optional when storage is unavailable.
        }
      })();
    </script>
    <style>
      :root {
        color-scheme: dark;
        --resume-canvas: #0a0a0a;
        --resume-surface: #161616;
        --resume-ink: #ffffff;
        --resume-muted: rgb(255 255 255 / 70%);
        --resume-soft: rgb(255 255 255 / 50%);
        --resume-border: rgb(255 255 255 / 14%);
      }

      :root[data-theme="light"] {
        color-scheme: light;
        --resume-canvas: #ffffff;
        --resume-surface: #f4f4f4;
        --resume-ink: #000000;
        --resume-muted: rgb(0 0 0 / 70%);
        --resume-soft: rgb(0 0 0 / 56%);
        --resume-border: rgb(0 0 0 / 14%);
      }

      @page {
        size: letter;
        margin: 0;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--resume-canvas);
        color: var(--resume-ink);
        font-family:
          "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, Helvetica,
          sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      body {
        display: flex;
        justify-content: center;
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration-color: var(--resume-border);
        text-underline-offset: 0.16em;
      }

      .page {
        width: 8.5in;
        min-height: 11in;
        padding: 0.38in 0.58in 0.34in;
        background: var(--resume-canvas);
      }

      .header {
        text-align: left;
        margin-bottom: 0.18in;
        padding-bottom: 0.105in;
        border-bottom: 1pt solid var(--resume-border);
      }

      h1 {
        margin: 0 0 0.055in;
        color: var(--resume-ink);
        font-size: 26pt;
        line-height: 1;
        font-weight: 600;
        letter-spacing: -0.04em;
      }

      .contact {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 0.07in 0.1in;
        color: var(--resume-muted);
        font-size: 10.2pt;
        font-weight: 400;
        line-height: 1.15;
      }

      .contact a + a::before {
        content: "|";
        margin-right: 0.1in;
        color: var(--resume-soft);
      }

      section {
        margin-top: 0.12in;
      }

      h2 {
        margin: 0 0 0.055in;
        padding-bottom: 0.032in;
        border-bottom: 1pt solid var(--resume-border);
        color: var(--resume-ink);
        font-size: 12.8pt;
        line-height: 1;
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
      }

      .entry {
        margin-bottom: 0.085in;
      }

      .entry:last-child {
        margin-bottom: 0;
      }

      .entry-head {
        display: flex;
        justify-content: space-between;
        gap: 0.18in;
        align-items: baseline;
        margin-bottom: 0.018in;
      }

      .entry-title {
        color: var(--resume-ink);
        font-size: 11.8pt;
        line-height: 1.15;
        font-weight: 600;
      }

      .entry-meta {
        flex: 0 0 auto;
        color: var(--resume-muted);
        font-size: 10.7pt;
        line-height: 1.15;
        text-align: right;
        white-space: nowrap;
      }

      .entry-role {
        display: flex;
        justify-content: space-between;
        gap: 0.18in;
        margin-bottom: 0.025in;
        color: var(--resume-muted);
        font-size: 10.8pt;
        line-height: 1.15;
        font-style: italic;
      }

      .entry-location {
        flex: 0 0 auto;
        color: var(--resume-muted);
        font-style: normal;
        text-align: right;
      }

      ul {
        margin: 0.015in 0 0 0.2in;
        padding-left: 0.12in;
      }

      li {
        margin: 0 0 0.016in;
        padding-left: 0.02in;
        color: var(--resume-muted);
        font-size: 9.25pt;
        line-height: 1.14;
      }

      li::marker {
        color: var(--resume-soft);
      }

      strong {
        color: var(--resume-ink);
        font-weight: 600;
      }

      .compact .entry {
        margin-bottom: 0.06in;
      }

      .skills-row {
        margin-bottom: 0.035in;
        font-size: 9.2pt;
        line-height: 1.14;
      }

      .skills-row strong {
        margin-right: 0.035in;
      }

      .theme-toggle {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        min-height: 2.75rem;
        padding: 0.6rem 0.8rem;
        border: 1px solid var(--resume-border);
        border-radius: 6px;
        background: var(--resume-surface);
        color: var(--resume-ink);
        font: inherit;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
      }

      .theme-toggle:focus-visible {
        outline: 2px solid var(--resume-ink);
        outline-offset: 3px;
      }

      @media (max-width: 760px) {
        body {
          display: block;
        }

        .page {
          width: 100%;
          min-height: 100vh;
          padding: 1.5rem 1rem 5rem;
        }

        .entry-head,
        .entry-role {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.04in;
        }

        .entry-meta,
        .entry-location {
          text-align: left;
          white-space: normal;
        }

        .theme-toggle {
          right: 1rem;
          bottom: 1rem;
        }
      }

      @media print {
        :root {
          color-scheme: light;
          --resume-canvas: #ffffff;
          --resume-surface: #ffffff;
          --resume-ink: #000000;
          --resume-muted: rgb(0 0 0 / 76%);
          --resume-soft: rgb(0 0 0 / 56%);
          --resume-border: rgb(0 0 0 / 16%);
        }

        html,
        body {
          background: #ffffff;
        }

        .page {
          min-height: 0;
          box-shadow: none;
        }

        .theme-toggle {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <h1>Naman Chetwani</h1>
        <nav class="contact" aria-label="Contact">
          {contactLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </header>

      <section class="compact">
        <h2>Projects</h2>

        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">Gemma 4 Inference Megakernel</div>
            <div class="entry-meta"><a href="https://github.com/coder-2011/gemma.c">GitHub repo</a></div>
          </div>
          <ul>
            <li>
              Writing <strong>gemma.c</strong>, a Gemma 4 megakernel written in CUDA and PTX. Full
              forward pass is one kernel.
            </li>
          </ul>
        </article>

        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">LPT</div>
            <div class="entry-meta"><a href="https://github.com/coder-2011/lpt">GitHub repo</a></div>
          </div>
          <ul>
            <li>
              Built a latent planning token path that injects planning tokens every n rollouts, then
              adds their final-layer hidden states to the next n rollouts.
            </li>
            <li>
              Improved perplexity by <strong>4.6%</strong> for <strong>0.3% overhead</strong> in a
              matched run; the mechanism should become more useful with scale.
            </li>
          </ul>
        </article>

        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">STRATUS UAV: Optimizing Prescribed Burning using UAVs and Predictive Modeling</div>
          </div>
          <ul>
            <li>
              Led development of a <strong>patent-pending autonomous UAV</strong> to mitigate
              wildfire spread; 3D-printed a VTOL aircraft for autonomous backburning with
              <strong>15 km range</strong> and <strong>1.2 hour endurance</strong>.
            </li>
            <li>
              Targeted core field constraints: helicopter operations around $16k/day, custom
              aircraft and pilots, and pilot liability; designed for <strong>5x lower price</strong>
              and <strong>3x higher range</strong> than the closest drone competitor.
            </li>
          </ul>
        </article>

        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">SBON (Strategic-Blackline-Optimization-Engine)</div>
            <div class="entry-meta"><a href="https://github.com/coder-2011/Strategic-Blackline-Optimization-Network">GitHub repo</a></div>
          </div>
          <ul>
            <li>
              Built a wildfire prediction model that <strong>set state-of-the-art results</strong>
              and created the first ML approach to optimizing prescribed burns.
            </li>
            <li>
              Built a tri-branch multimodal architecture across <strong>13 input modalities</strong>
              spanning fire imagery, weather, and geography; ConvNeXt and SSM encoders feed a
              larger SSM for 4-hour fire-mask prediction.
            </li>
            <li>
              Treated the model as an environment, rolled out predictions to <strong>48 hours</strong>,
              and used PPO to optimize burn placement in a niche field with fewer than 20 papers in
              the last 30 years.
            </li>
          </ul>
        </article>

        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">The no-circles project</div>
            <div class="entry-meta">
              <a href="https://no-circles.com">no-circles.com</a> · <a href="https://github.com/coder-2011/no-circles">GitHub repo</a>
            </div>
          </div>
          <ul>
            <li>
              Built a personalized daily newsletter that learns from each reader's replies and
              behavior; scaled to <strong>triple-digit users within 3 weeks</strong>.
            </li>
            <li>
              Built the user memory, daily brief, and reply feedback loop to explain unfamiliar
              fields through topics each reader already cares about.
            </li>
          </ul>
        </article>

        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">PHOENIX UAV / Science Fair Results</div>
            <div class="entry-meta"><a href="https://github.com/coder-2011/PHEONIX-UAV-v1">GitHub repo</a></div>
          </div>
          <ul>
            <li>
              Built PHOENIX UAV for early wildfire detection; placed <strong>2nd in the California
              State Science Fair</strong>, <strong>1st at regionals</strong>, and won 5 awards
              including the Henkel aerospace award and Junior Lemelson-MIT Inventor Award.
            </li>
          </ul>
        </article>
      </section>

      <section>
        <h2>Work</h2>
        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">Portfolio Manager</div>
          </div>
          <ul>
            <li>
              Manage a <strong>seven-figure household equity portfolio</strong>, up
              <strong>47% YTD</strong> as of May 31, 2026; trades are partially handled through
              software agents that monitor markets, flag changes, and execute position updates.
            </li>
          </ul>
        </article>

        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">Fire Technology Contract Work</div>
          </div>
          <div class="entry-role">
            <div>Hardware / Systems Engineer</div>
          </div>
          <ul>
            <li>
              Under contract building machines for fire tech companies, combining autonomous
              hardware, manufacturing, and systems built for field use.
            </li>
          </ul>
        </article>
      </section>

      <section>
        <h2>Education</h2>
        <article class="entry">
          <div class="entry-head">
            <div class="entry-title">Independent Study / Competitions</div>
          </div>
          <ul>
            <li>
              Selected for <strong>SPARC '26</strong> (3% acceptance rate); achieved
              <strong>USACO Gold</strong> and F=MA qualifying scores in the top 5% nationally.
            </li>
            <li>
              Competed in CALICO, Harker Physics Invitational, and Harker Programming Invitational;
              held a top 30 national placement in MSPF Debate with 2 tournament wins and
              elimination rounds at Stanford and TOC.
            </li>
          </ul>
        </article>
      </section>

    </main>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false">
      <span data-theme-label>Light mode</span>
    </button>
    <script>
      // Synchronizes the resume with the site's persisted theme preference.
      (() => {
        const root = document.documentElement;
        const button = document.querySelector("#theme-toggle");
        const label = document.querySelector("[data-theme-label]");
        const themeColor = document.querySelector('meta[name="theme-color"]');

        if (!(button instanceof HTMLButtonElement) || !(label instanceof HTMLElement)) {
          return;
        }

        // Applies the selected theme and keeps the control label accurate.
        const setTheme = (theme) => {
          const isLight = theme === "light";
          root.dataset.theme = isLight ? "light" : "dark";
          button.setAttribute("aria-pressed", String(isLight));
          button.setAttribute("aria-label", isLight ? "Switch to dark mode" : "Switch to light mode");
          label.textContent = isLight ? "Dark mode" : "Light mode";
          themeColor?.setAttribute("content", isLight ? "#ffffff" : "#0a0a0a");

          try {
            window.localStorage.setItem("naman-theme", isLight ? "light" : "dark");
          } catch {
            // The theme still works for this page view when storage is unavailable.
          }
        };

        setTheme(root.dataset.theme === "light" ? "light" : "dark");

        // Toggles between the two supported themes.
        button.addEventListener("click", () => {
          setTheme(root.dataset.theme === "light" ? "dark" : "light");
        });
      })();
    </script>
  </body>
</html>

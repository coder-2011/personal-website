---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <title>Zoom OAuth callback</title>
  </head>
  <body>
    <main class="page">
      <article class="essay">
        <h1>Zoom OAuth callback</h1>
        <p>Zoom sent your browser here after development authorization.</p>
        <p>
          Copy the <code>code</code> parameter from the address bar to exchange it for a token. If
          authorization failed, inspect the <code>error</code> parameter instead.
        </p>
      </article>
    </main>
  </body>
</html>

---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Naman Chetwani",
  description = "Personal website for Naman Chetwani.",
  noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/no-circles-logo.png" />
    <link rel="apple-touch-icon" href="/no-circles-logo.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Restores the chosen theme before the page paints.
      (() => {
        try {
          if (window.localStorage.getItem("naman-theme") === "light") {
            document.documentElement.dataset.theme = "light";
            document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#ffffff");
          }
        } catch {
          // Theme preference is optional when storage is unavailable.
        }
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <slot />

    <footer class="site-footer">
      <span>Naman Chetwani</span>
      <nav aria-label="Contact">
        <a href="mailto:naman.chetwani@gmail.com">Email</a>
        <a href="tel:+19258959674">Call</a>
        <a href="https://github.com/coder-2011" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://discordapp.com/users/904441943298310204" target="_blank" rel="noreferrer">Discord</a>
      </nav>
    </footer>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false">
      <span data-theme-label>Light mode</span>
    </button>

    <script is:inline>
      // Synchronizes the global theme state with its only persistent control.
      (() => {
        const root = document.documentElement;
        const button = document.querySelector("#theme-toggle");
        const label = document.querySelector("[data-theme-label]");
        const themeColor = document.querySelector('meta[name="theme-color"]');

        if (!(button instanceof HTMLButtonElement) || !(label instanceof HTMLElement)) {
          return;
        }

        // Applies a theme and updates the control's accessible label.
        const setTheme = (theme) => {
          const isLight = theme === "light";
          root.dataset.theme = isLight ? "light" : "dark";
          button.setAttribute("aria-pressed", String(isLight));
          button.setAttribute("aria-label", isLight ? "Switch to dark mode" : "Switch to light mode");
          label.textContent = isLight ? "Dark mode" : "Light mode";
          themeColor?.setAttribute("content", isLight ? "#ffffff" : "#0a0a0a");

          try {
            window.localStorage.setItem("naman-theme", isLight ? "light" : "dark");
          } catch {
            // The page remains fully usable when storage is unavailable.
          }
        };

        setTheme(root.dataset.theme === "light" ? "light" : "dark");

        // Switches to the opposite theme when the control is activated.
        button.addEventListener("click", () => {
          setTheme(root.dataset.theme === "light" ? "dark" : "light");
        });
      })();
    </script>
  </body>
</html>

---
import "../styles/global.css";
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Naman Chetwani",
  description = "Personal website for Naman Chetwani."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2ed" />
    <script is:inline>
      (() => {
        let theme = "light";
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") theme = saved;
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === "light" ? "#f7f2ed" : "#211b19";
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/et-book-v1/roman.woff" as="font" type="font/woff" crossorigin />
  </head>
  <body>
    <slot />
    <footer class="site-footer" aria-label="Contact">
      <a href="https://discordapp.com/users/904441943298310204" target="_blank" rel="noreferrer">Discord</a>
      <a href="tel:+19258959674">+1 925 895 9674</a>
      <a href="https://github.com/coder-2011" target="_blank" rel="noreferrer">GitHub</a>
    </footer>
    <ThemeToggle />
  </body>
</html>

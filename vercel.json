{
  "redirects": [
    {
      "source": "/diffs",
      "destination": "https://diffs.naman.world",
      "permanent": false
    },
    {
      "source": "/diffs/:path*",
      "destination": "https://diffs.naman.world/:path*",
      "permanent": false
    },
    {
      "source": "/resume",
      "destination": "/resume.pdf",
      "permanent": false
    },
    {
      "source": "/blogs",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/embeds/bpe.html",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/et-book-v1/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}

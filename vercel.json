{
  "redirects": [
    {
      "source": "/diffs",
      "destination": "https://diffs.naman.world",
      "permanent": false
    },
    {
      "source": "/diffs/:path*",
      "destination": "https://diffs.naman.world/:path*",
      "permanent": false
    },
    {
      "source": "/resume",
      "destination": "/resume.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/embeds/bpe.html",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}

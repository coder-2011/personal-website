{
  "name": "naman-personal-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --host --port 3000",
    "start": "astro dev --host --port 3000",
    "build": "astro build",
    "preview": "wrangler dev --port 8787",
    "plugin:build": "node obsidian-plugin/build.mjs",
    "plugin:check": "tsc -p obsidian-plugin/tsconfig.json",
    "test:blog": "node --test tests/blog*.test.mjs",
    "prebuild": "node scripts/build-embed-examples.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/markdown-remark": "6.3.11",
    "astro": "^5.7.1",
    "css-tree": "3.2.1",
    "github-slugger": "2.0.0",
    "katex": "0.18.7",
    "parse5": "7.3.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "saxes": "6.0.0",
    "sharp": "0.34.5",
    "shiki": "^3.23.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.27.7",
    "jsdom": "26.1.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "wrangler": "^4.136.1"
  }
}
